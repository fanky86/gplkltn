# ==== Server ====
PORT=5017
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ==== Keamanan ====
# Ganti dengan string acak panjang (boleh generate: openssl rand -hex 32)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# ==== Daftar admin ====
# Email yang boleh login sebagai admin (login Google ATAU OTP email keduanya
# hanya akan dianggap "admin" kalau emailnya ada di daftar ini)
# Pisahkan dengan koma kalau lebih dari satu.
ADMIN_EMAILS=admin@gplkltn.site,ketua@gplkltn.site

# ==== Google OAuth ====
# Buat di https://console.cloud.google.com/apis/credentials
# Authorized origin: http://localhost:5173 dan https://gplkltn.site
GOOGLE_CLIENT_ID=isi-dengan-google-client-id.apps.googleusercontent.com

# ==== Email OTP (SMTP) ====
# Contoh pakai Gmail App Password, atau SMTP dari provider domain (mis. cPanel/DomainPop/Zoho)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gplkltn.site
SMTP_PASS=app-password-smtp-kamu
MAIL_FROM="GPLKLTN <noreply@gplkltn.site>"

# Kalau SMTP belum diisi/salah, sistem otomatis fallback: kode OTP akan
# ditampilkan di terminal server (mode development), supaya tetap bisa dites.
